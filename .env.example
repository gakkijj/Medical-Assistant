# OpenAI-compatible LLM endpoint
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# Optional cloud memory. Leave empty to disable Mem0.
MEM0_API_KEY=

# Comma-separated browser origins allowed by FastAPI.
MEDIX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MEDIX_RETRIEVER=hybrid
MEDIX_MAX_CONCURRENCY=8
MEDIX_REQUEST_TIMEOUT_SECONDS=120
# Debug only; keep false in shared or production deployments.
MEDIX_EXPOSE_RAW_RESPONSE=false

# Optional override used by Docker for persistent Milvus Lite storage.
# MILVUS_DB_PATH=/app/runtime/milvus_lite.db
